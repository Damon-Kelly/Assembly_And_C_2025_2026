     5                                  section .data
     6 00000000 456E746572206E756D-         prompt           db "Enter number: "
     6 00000009 6265723A20         
     7                                      prompt_len       equ $-prompt
     8 0000000E 5468652073756D2069-         result_label     db "The sum is: "
     8 00000017 733A20             
